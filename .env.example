# ---------------------------------------------------------------- models
# Providers: anthropic, openrouter, mock (offline). The default route is used by every
# tier left empty, except on anthropic: lite defaults to claude-haiku-4-5, standard and
# coding to claude-sonnet-5-5, and the strong tier uses LLM_MODEL.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Lite tier: low-difficulty work (search queries, extraction, summaries, rewriting)
LLM_LITE_PROVIDER=
LLM_LITE_MODEL=
LLM_LITE_REASONING_EFFORT=auto
LLM_LITE_TEMPERATURE=
LLM_LITE_MAX_TOKENS=0

# Standard tier: high and medium-high work (gaps, interpretation, planning, drafting)
LLM_STANDARD_PROVIDER=
LLM_STANDARD_MODEL=
LLM_STANDARD_REASONING_EFFORT=auto
LLM_STANDARD_TEMPERATURE=
LLM_STANDARD_MAX_TOKENS=0

# Strong tier: very-high-difficulty reasoning (novelty, critique, hypotheses, design, review)
LLM_STRONG_PROVIDER=
LLM_STRONG_MODEL=
LLM_STRONG_REASONING_EFFORT=auto
LLM_STRONG_TEMPERATURE=
LLM_STRONG_MAX_TOKENS=0

# Coding tier: experiment implementation (falls back to the standard tier)
LLM_CODING_PROVIDER=
LLM_CODING_MODEL=
LLM_CODING_REASONING_EFFORT=auto
LLM_CODING_TEMPERATURE=
LLM_CODING_MAX_TOKENS=0

# Recommended mix (scores: Artificial Analysis Intelligence Index, October 2026):
#   lite      openrouter / openai/gpt-6-luna             index 38   $0.10 / $0.50 per MTok
#   standard  openrouter / anthropic/claude-sonnet-5.5   index 56   $2 / $10   (coding falls back to it)
#   strong    anthropic  / claude-opus-5-5 at medium effort, falling back to openrouter / anthropic/claude-opus-5.5
# LLM_LITE_PROVIDER=openrouter
# LLM_LITE_MODEL=openai/gpt-6-luna
# LLM_STANDARD_PROVIDER=openrouter
# LLM_STANDARD_MODEL=anthropic/claude-sonnet-5.5
# LLM_STRONG_REASONING_EFFORT=medium
# LLM_FALLBACK_PROVIDER=openrouter
# LLM_FALLBACK_MODEL=anthropic/claude-opus-5.5

# Using OpenRouter instead: set LLM_PROVIDER=openrouter and give LLM_MODEL (and any tier you
# want cheaper) an OpenRouter model id from openrouter.ai/models. The Haiku and Sonnet defaults are anthropic-only.

# Reasoning effort: auto (follow task difficulty), low, medium, high, or none (send nothing).
# Temperature applies to OpenRouter models only; the Anthropic SDK no longer takes sampling parameters.
# Difficulty thresholds for the standard and strong tiers: low, low_medium, medium, medium_high, high, very_high
LLM_STANDARD_MIN_DIFFICULTY=medium_high
LLM_STRONG_MIN_DIFFICULTY=very_high
LLM_ESCALATE_ON_FAILURE=true
# Move single tasks between tiers, e.g. critique.design=standard,hypothesis.design=standard
# keeps design critique and hypothesis design off the strong tier (the largest cost).
LLM_TASK_OVERRIDES=
# Extra prices (USD per million tokens, [input, output]); Claude prices are built in.
LLM_PRICING=

LLM_ROUTE_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_RETRY_MAX_ATTEMPTS=4
LLM_RETRY_BASE_DELAY_S=1.0
LLM_RETRY_MAX_DELAY_S=8.0
LLM_REQUEST_TIMEOUT_S=600

# ---------------------------------------------------------------- literature
# openalex, arxiv, semantic_scholar, mock (comma separated)
LITERATURE_PROVIDERS=openalex,arxiv
LITERATURE_RESULTS_PER_QUERY=8
LITERATURE_MAX_PAPERS=50
LITERATURE_CITATION_SEED_K=3
LITERATURE_CITATION_LIMIT=5
LITERATURE_FULLTEXT_TOP_K=0
LITERATURE_EXTRACTION_BATCH=4
OPENALEX_API_KEY=
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

# Optional web search for the Field Scout only: none, tavily, serpapi, mock
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ---------------------------------------------------------------- orchestration
WORKSPACE_DIR=./projects
MAX_STEPS=60
MAX_LITERATURE_ROUNDS=2
MAX_PROPOSAL_REVISIONS=1
MAX_REVIEW_ROUNDS=2
MAX_EXPERIMENT_RUNS=8
MAX_RUNS_PER_SPEC=2
MAX_TOTAL_TOKENS=0
# Budgets are cumulative per project. A first reviewed draft with two experiments cost $6.75 on
# the label-smoothing test project, mostly strong-tier design work. Raise the cap to continue.
MAX_COST_USD=7.00
MAX_SECONDS=0
DEFAULT_SEEDS=3
SIGNIFICANCE_ALPHA=0.05
ALLOW_SYNTHETIC_EVIDENCE=false

# ---------------------------------------------------------------- experiments
# manual (review and run yourself), subprocess (runs generated code locally; not a sandbox), simulated
EXPERIMENT_EXECUTOR=manual
EXPERIMENT_TIMEOUT_S=900
EXPERIMENT_PYTHON=
EXPERIMENT_MAX_REPAIRS=1

# ---------------------------------------------------------------- api
API_AUTH_TOKEN=
API_RATE_LIMIT_PER_MINUTE=0
